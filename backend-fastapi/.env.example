# Database Connection String
# Use the direct connection string (port 5432) with postgresql+asyncpg:// driver scheme for long-lived FastAPI services.
# Note: Django uses sync postgresql://, while FastAPI requires the async driver postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# CORS Origins (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Environment Mode
ENVIRONMENT=development
