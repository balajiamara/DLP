# Database Connection String
# Use the direct connection string (port 5432) with postgresql+asyncpg:// driver scheme for long-lived FastAPI services.
DATABASE_URL=postgresql+asyncpg://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# CORS Origins (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Environment Mode
ENVIRONMENT=development

# Google Gemini API Key for Embeddings (gemini-embedding-001)
GEMINI_API_KEY=your-gemini-api-key-here

# Shared Internal Service Secret Header (X-Internal-Secret) for server-to-server auth
INTERNAL_SERVICE_SECRET=dlp-internal-secret-key-change-me

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
