# Supabase PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Django Secret Key (Generate a random 50+ character string for production)
SECRET_KEY=your-production-secret-key-here

# Debug Mode (Set to True for local development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated list of domain names / hostnames allowed to serve the app)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# CORS Allowed Origins (Comma-separated list of origins allowed to make cross-origin HTTP requests)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

